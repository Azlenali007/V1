<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"

    # API routes to PHP scripts
    RewriteRule ^api/(.*)$ api/$1 [QSA,L]
    RewriteRule ^admin/api/(.*)$ admin/api/$1 [QSA,L]

    # Explicit application routes
    RewriteRule ^login/?$ index.php [QSA,L]
    RewriteRule ^register/?$ index.php [QSA,L]
    RewriteRule ^admin/?$ index.php [QSA,L]
    RewriteRule ^dashboard/?$ index.php [QSA,L]
    RewriteRule ^orders/?$ index.php [QSA,L]
    RewriteRule ^wallet/?$ index.php [QSA,L]
    RewriteRule ^services/?$ index.php [QSA,L]

    # Allow direct access to existing files and directories (css, js, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rewrite all other requests to index.php
    RewriteRule ^ index.php [L]
</IfModule>
